                    108;
                    (18 * (N([ln2; ln7], [(ln2 + 1) != ln7], [0 + 1; m[52]], [ln2 + 1; ln7]))) + 1
                  ])) * (N([ln9; m[56]], [(ln9 + 1) < m[56]], [0; m[56]], [ln9 + 1; m[56]]));
                  (list_sum([
                    84;
